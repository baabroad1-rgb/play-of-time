<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Leaderboard sync (Alex 2026-08-12): best-effort background upload of
         anonymized attempts to playoftime.online/api/, mirroring the webapp's
         leaderboard. Never blocks gameplay if unavailable. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ⚠️ ВРЕМЕННАЯ ЗАПЛАТКА — УДАЛИТЬ ПРИ ВЫХОДЕ В GOOGLE PLAY.
         Самообновление вне Google Play (Alex 2026-09-22): позволяет запустить
         системную установку скачанного APK через FileProvider (ACTION_VIEW
         на application/vnd.android.package-archive). Без этого разрешения
         intent на установку либо не запустится, либо Android сам заблокирует
         его до ручного разрешения "Install unknown apps" в настройках.
         Полный комментарий про заплатку — core/update/UpdateApi.kt. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Выгрузка истории игрока. Уровень signature: разрешение получает только
         приложение, подписанное тем же ключом, — проверяет сама система.
         Нужно для переезда на переименованный пакет (online.playoftime):
         для Android это другое приложение со своей пустой базой, и историю
         оно забирает отсюда при первом запуске.
         Имя разрешения — литерал, а не ${applicationId}: его объявляет ЭТО
         приложение, а запрашивает по этой же строке новое. -->
    <permission
        android:name="ru.iflex.timemvp.quest.permission.EXPORT_PLAY_DATA"
        android:label="@string/permission_export_play_data_label"
        android:description="@string/permission_export_play_data_description"
        android:protectionLevel="signature" />
    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:appCategory="game"
        android:isGame="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimeMVP"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
        <!-- Отдача истории игрока, только на чтение. Подробности — в
             core/export/PlayDataProvider.kt, внешнее описание — в
             docs/CONTENT_PROVIDER_CONTRACT.md. -->
        <provider
            android:name=".core.export.PlayDataProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true"
            android:readPermission="ru.iflex.timemvp.quest.permission.EXPORT_PLAY_DATA" />

    </application>

</manifest>